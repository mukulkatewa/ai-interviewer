{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:api": "uv run --directory ../api python -m app.openapi > .openapi.json && openapi-typescript .openapi.json -o src/lib/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "vad:assets": "node scripts/copy-vad-assets.mjs",
    "predev": "npm run vad:assets",
    "prebuild": "npm run vad:assets",
    "test:unit": "node --experimental-strip-types --no-warnings --test src/lib/interview/*.test.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ricky0123/vad-web": "^0.0.31",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "posthog-js": "1.438.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "^7.13.0",
    "pg": "8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
