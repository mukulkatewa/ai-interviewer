# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_RESUME_MODEL=openai/gpt-oss-120b
GROQ_RESUME_EFFORT=low
GROQ_JD_MODEL=openai/gpt-oss-20b
GROQ_JD_EFFORT=low
GROQ_LIVE_MODEL=openai/gpt-oss-20b
GROQ_LIVE_EFFORT=low
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
GROQ_ANALYSIS_EFFORT=medium

# Supabase (public values only; the backend never needs the secret key)
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase dashboard -> Connect -> Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Frontend origins allowed to call the API from a browser (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Kokoro TTS (docker compose --profile speech)
KOKORO_URL=http://localhost:8880
KOKORO_VOICE=af_heart

# --- Production hardening (all optional) -------------------------------------------------
# Simultaneous interviews one server can hold (Kokoro on 4 CPUs: 2, see docs/benchmarks/tts-concurrency-2026-10-29.md)
MAX_LIVE_INTERVIEWS=2
# Error tracking (https://sentry.io, free tier). Leave blank to turn off; request bodies are never sent.
SENTRY_DSN=
ENVIRONMENT=production
# Second providers, used when Groq is rate limited or failing. Any OpenAI-style API works.
# Example: Cerebras (free tier) https://api.cerebras.ai/v1 with model gpt-oss-120b
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
# Speech-to-text fallback: an OpenAI-style /audio/transcriptions endpoint
FALLBACK_STT_BASE_URL=
FALLBACK_STT_API_KEY=
FALLBACK_STT_MODEL=whisper-1
