# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_RESUME_MODEL=openai/gpt-oss-120b
GROQ_RESUME_EFFORT=low
GROQ_JD_MODEL=openai/gpt-oss-20b
GROQ_JD_EFFORT=low
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
GROQ_ANALYSIS_EFFORT=medium

# Supabase (public values only; the backend never needs the secret key)
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase dashboard -> Connect -> Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Frontend origins allowed to call the API from a browser (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Kokoro TTS (docker compose --profile speech)
KOKORO_URL=http://localhost:8880
KOKORO_VOICE=af_heart
